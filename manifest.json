{
	"manifest_version": 2,
	"name": "Download Images in Element",
	"version": "1.0.1.0",
	"description": "Pick an element and download the images inside it as a ZIP archive.",
	"icons": {
		"512": "icons/icon-512.png"
	},
	"permissions": ["activeTab", "downloads", "contextMenus", "<all_urls>"],
	"background": {
		"scripts": ["background.js"],
		"persistent": false
	},
	"browser_action": {
		"default_title": "Download Images in Element",
		"default_icon": {
			"512": "icons/icon-512.png"
		}
	},
	"content_security_policy": "script-src 'self'; object-src 'self'",
	"browser_specific_settings": {
		"gecko": {
			"id": "download-images-in-element@jakepark",
			"data_collection_permissions": {
				"required": ["none"]
			}
		},
		"gecko_android": {}
	}
}
